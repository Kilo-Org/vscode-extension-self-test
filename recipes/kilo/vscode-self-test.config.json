{
  "extensionRoot": "packages/kilo-vscode",
  "workspace": ".",
  "extensionId": "kilocode.kilo-code",
  "build": { "command": ["bun", "run", "package"] },
  "vsix": { "command": ["bun", "x", "vsce", "package", "--no-dependencies", "--skip-license", "-o", "{outDir}/"] },
  "profile": { "markPrefix": "kilo." },
  "openers": {
    "sidebarActivityLabel": "^Kilo Code",
    "sidebarCommand": "View: Focus on Kilo Code View",
    "agentManagerLabel": "Agent Manager",
    "agentManagerFrameSelector": ".am-layout",
    "settingsSelector": ".title-actions a.action-label[aria-label=\"Settings\"]",
    "settingsFrameSelector": "[data-component=\"tabs\"][data-variant=\"settings\"]"
  }
}
